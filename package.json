{
  "name": "heritage-restaurant",
  "version": "2.0.0",
  "private": true,
  "description": "Héritage — restaurant gastronomique à Bastos, Yaoundé. Site vitrine bilingue et réservation en ligne (Next.js, React, PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "images:optimize": "node scripts/optimize-images.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "motion": "12.43.0",
    "next": "16.3.8",
    "next-intl": "4.14.7",
    "nodemailer": "10.0.11",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.30.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
