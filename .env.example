# ─────────────────────────────────────────────────────────────────────────────
# Héritage — variables d'environnement
# Copier ce fichier en .env.local (jamais dans git). AUCUNE n'est obligatoire
# pour tester en local : sans configuration, le site utilise une base PostgreSQL
# embarquée (PGlite) et écrit les e-mails dans .outbox/ au lieu de les envoyer.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique du site (balises canoniques, OpenGraph, sitemap, liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://www.heritage-bastos.cm

# ── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, Vercel Postgres, serveur dédié…). Obligatoire en production.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/heritage?sslmode=require
# DATABASE_POOL_MAX=5
# Base locale PGlite (développement) : dossier de stockage, par défaut .data/pglite
# PGLITE_DATA_DIR=.data/pglite

# ── E-mails ──────────────────────────────────────────────────────────────────
# Adresse qui reçoit les alertes de réservation et les messages de contact
RESTAURANT_EMAIL=reservations@heritage-bastos.cm
# Expéditeur affiché (domaine vérifié chez votre fournisseur)
MAIL_FROM=Héritage <reservations@heritage-bastos.cm>
# Option 1 — Resend (recommandé sur Vercel) : https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# Option 2 — n'importe quel serveur SMTP (Gmail, Brevo, OVH, Mailjet…)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Numéro WhatsApp officiel (international, chiffres uniquement)
NEXT_PUBLIC_WHATSAPP_NUMBER=237659855617
# Facultatif : alerte WhatsApp automatique au restaurant via l'API Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_TO=+237659855617
# Modèle WhatsApp approuvé (requis hors fenêtre de 24 h) : variables {{1}} réf., {{2}} date, {{3}} couverts, {{4}} nom
# TWILIO_CONTENT_SID=HXxxxxxxxx

# ── Réservations ─────────────────────────────────────────────────────────────
# true : les réservations sont confirmées automatiquement (sinon l'équipe confirme dans /admin)
RESERVATION_AUTO_CONFIRM=false

# ── Sécurité & administration ────────────────────────────────────────────────
# Sel des empreintes d'adresses IP (limitation de débit) : longue chaîne aléatoire
AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Protège la tâche planifiée de relance des e-mails (/api/cron/notifications)
CRON_SECRET=remplacez-par-une-autre-chaine-aleatoire
# Compte admin créé automatiquement en local (base PGlite) ; en production : npm run admin:create
# ADMIN_EMAIL=admin@heritage.local
# ADMIN_PASSWORD=au-moins-12-caracteres

# ── Contact & réseaux sociaux (affichés seulement s'ils sont renseignés) ─────
# NEXT_PUBLIC_CONTACT_EMAIL=contact@heritage-bastos.cm
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/...
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/...
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@...
